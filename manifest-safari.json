{
  "manifest_version": 3,
  "name": "Universal Prompt Library",
  "version": "1.3.2",
  "description": "Una potente extensión para gestionar e inyectar prompts en cualquier chatbot de IA.",
  "author": "Carlos Guadián Orta <admin@k-government.com>",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "sidepanel.html?embed=popup",
    "default_title": "Universal Prompt Library",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
